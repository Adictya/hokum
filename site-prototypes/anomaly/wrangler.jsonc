{
  "name": "hokum-hero-anomaly",
  "account_id": "15d29c8639fd3733b1b5486a2acfd968",
  "main": "worker.ts",
  "compatibility_date": "2026-06-01",
  "assets": {
    "directory": "public",
    "binding": "ASSETS",
    "run_worker_first": true,
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "none"
  },
  "routes": [
    { "pattern": "anoma.ly/labs/hokum-anomaly", "zone_name": "anoma.ly" },
    { "pattern": "anoma.ly/labs/hokum-anomaly/*", "zone_name": "anoma.ly" }
  ],
  "workers_dev": false,
  "preview_urls": false
}
